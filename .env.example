# Copy this file to .env and fill in your own values. NEVER commit the real .env file.

# Get a free RPC URL from Alchemy or Infura (Sepolia network)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Your wallet's private key (use a DEDICATED throwaway testnet wallet, never your main one)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Get free from https://etherscan.io/apis
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Filled in after running DeployToken.s.sol
TOKEN_ADDRESS=
